[Unit]
Description=VPN Access Point Router
Documentation=https://github.com/RFingAdam/VPN-AP
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=AP_INTERFACE=wlan1
Environment=VPN_INTERFACE=wg0
Environment=VPN_MODE=auto
Environment=HOME=/root
EnvironmentFile=-/etc/default/vpn-ap

# Apply the configured AP mode FIRST — renders per-interface hostapd configs
# into /run/vpn-ap/ (which is empty on boot) and starts the template
# instances. Reads AP_MODE from the EnvironmentFile above.
ExecStartPre=/bin/bash -c '/usr/local/bin/vpn-ap-mode "${AP_MODE:-single}"'

# Start the access point (AP will be ready for connections)
ExecStart=/usr/local/bin/vpn-ap-start

# Start captive portal web interface
ExecStartPost=/bin/systemctl start captive-portal

# Enforce the final firewall mode AFTER captive-portal has finished booting.
# captive-portal-server.py applies captive-mode iptables on startup (by design
# for the hotel-WiFi onboarding flow), which flushes our forwarding rules.
# VPN_AP_BOOT_MODE in /etc/default/vpn-ap chooses the final desired state:
#   captive  — leave captive-portal's rules alone (v1.4.0 default flow)
#   internet — re-apply iptables-internet-mode so AP clients have internet
#              with NO VPN (useful for no-VPN deployments, e.g. iPhone tether
#              upstream without NordVPN configured)
#   vpn      — expects VPN is configured separately; iptables-vpn-mode
#              applies the kill-switch
# Short sleep gives captive-portal time to finish its iptables-captive-mode run.
ExecStartPost=/bin/bash -c 'sleep 3; case "${VPN_AP_BOOT_MODE:-captive}" in \
    internet) /usr/local/bin/iptables-internet-mode.sh ;; \
    vpn)      /usr/local/bin/iptables-vpn-mode.sh ;; \
    *) ;; \
  esac'

# Note: VPN is NOT auto-started - user configures WiFi via captive portal first
# The captive portal will connect VPN after WiFi is configured

# Stop services on service stop
ExecStop=/usr/local/bin/vpn-stop
ExecStop=/usr/bin/systemctl stop captive-portal
ExecStop=/usr/bin/systemctl stop hostapd
ExecStop=/usr/bin/systemctl stop dnsmasq

# Clear iptables on stop
ExecStopPost=/sbin/iptables -F
ExecStopPost=/sbin/iptables -t nat -F
ExecStopPost=/sbin/iptables -P INPUT ACCEPT
ExecStopPost=/sbin/iptables -P FORWARD ACCEPT
ExecStopPost=/sbin/iptables -P OUTPUT ACCEPT

[Install]
WantedBy=multi-user.target
